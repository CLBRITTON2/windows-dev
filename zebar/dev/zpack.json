{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "dev",
  "version": "1.1.1",
  "description": "",
  "tags": [],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "**/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          {
            "urlRegex": "api\\.github\\.com",
            "duration": 0
          },
          {
            "urlRegex": "current-layout\\.txt",
            "duration": 0
          }
        ]
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "54px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "ziti-menu",
      "htmlPath": "./ziti-menu.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "**/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          {
            "urlRegex": "api\\.github\\.com",
            "duration": 0
          }
        ]
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
            "argsRegex": "^https://github\\.com/\\S*$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-5px",
          "offsetY": "59px",
          "width": "380px",
          "height": "160px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}