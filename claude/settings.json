{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(/usr/bin/ls *)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(grep:*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr comments:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh status:*)",
      "Bash(gh search:*)",
      "Bash(mkdir:*)",
      "Bash(timeout:*)",
      "Bash(sleep:*)",
      "Bash(go mod:*)",
      "Bash(cmake -S*)",
      "Bash(cmake -B*)",
      "Bash(cmake --preset*)",
      "Bash(cmake --build*)",
      "Bash(cmake --list-presets*)",
      "Bash(node ./scripts/*)",
      "Bash(npm run *)",
      "Bash(yarn run *)",
      "Bash(xargs grep :*)",
      "Bash(go build:*)",
      "Read(~/dev/openziti/**)",
      "Read(~/dev/windows-dev/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(code-review)",
      "Bash(go vet *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(gofmt *)",
      "Bash(git merge-tree*)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(gh api -X GET:*)",
      "Bash(gh run watch:*)",
      "Bash(git merge-base *)"
    ],
    "deny": [
      "Bash(git checkout*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git merge *)",
      "Bash(git tag*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch -m*)",
      "Bash(git branch -c*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git worktree move*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(./secrets/**)",
      "Read(~/.encrypted/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(/e/**)",
      "Edit(/e/**)",
      "Artifact",
      "mcp__claude_ai_Claude_Docs"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/hooks/pre-tool-use-hook.ps1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/herdr/focus-file/record-edited-dir.ps1",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/hooks/lint-edited-lines.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\claude\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/hooks/label-herdr-workspace.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 10000,
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/statusline.ps1"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  },
  "outputStyle": "Terse Engineer",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoCompactWindow": 200000,
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:terminal",
  "switchModelsOnFlag": false
}
