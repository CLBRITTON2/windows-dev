{
  "attribution": false,
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(/usr/bin/ls *)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(grep:*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr comments:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh status:*)",
      "Bash(gh search:*)",
      "Bash(mkdir:*)",
      "Bash(timeout:*)",
      "Bash(sleep:*)",
      "Bash(go mod:*)",
      "Bash(cmake -S*)",
      "Bash(cmake -B*)",
      "Bash(cmake --preset*)",
      "Bash(cmake --build*)",
      "Bash(cmake --list-presets*)",
      "Bash(node ./scripts/*)",
      "Bash(npm run *)",
      "Bash(yarn run *)",
      "Bash(rm -rf ./build)",
      "Bash(rm -rf ./dist)",
      "Bash(rm -rf ./node_modules)",
      "Bash(pkill -f node)",
      "Bash(pkill -f dev-server)",
      "Bash(xargs grep :*)",
      "Bash(ziti:*)",
      "Bash(go build:*)",
      "Read(//c/temp/**)",
      "Read(~/dev/openziti/**)",
      "Read(~/dev/windows-dev/**)",
      "Edit(//c/temp/**)",
      "Read(/tmp/**)",
      "Edit(/tmp/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Skill(code-review)",
      "Bash(curl:*)",
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(ssh.exe *)",
      "Bash(git merge-tree*)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(gh api -X GET:*)",
      "Bash(gh run watch:*)",
      "Bash(git merge-base *)",
      "Bash(pwsh -NoProfile -File ~/dev/windows-dev/scripts/update-ziti-repos.ps1 -Root ~/dev/openziti)"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git clean*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git rebase*)",
      "Bash(git merge *)",
      "Bash(git tag*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git branch -m*)",
      "Bash(git branch -c*)",
      "Bash(git switch -c*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue comment*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh workflow run*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Bash(find *)",
      "Read(./secrets/**)",
      "Read(~/.encrypted/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(/e/**)",
      "Edit(/e/**)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Artifact",
      "mcp__claude_ai_Claude_Docs"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Shell writes to repo files: creating, changing, renaming or deleting files under ~/dev through a shell command, interpreter or script, including relative paths, since the shell starts inside a repo. Examples: sed -i, perl -i, redirection or heredoc, tee, cp, mv, rm, touch, patch, git apply, Set-Content, Out-File, [IO.File] writes, and node, pwsh or other scripts that write files, including a script written elsewhere that then writes into ~/dev. Repo changes go through the Edit or Write tool so the owner reviews the diff. Not this rule: package managers, builds, tests, formatters and code generators writing their usual outputs (node_modules, build and dist directories, lockfiles, go.sum, gofmt -w), and any write outside ~/dev, such as the session scratchpad."
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/hooks/pre-tool-use-hook.ps1",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/herdr/focus-file/record-edited-dir.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo reminder for chat replies only, not prose written into files or commits: 1-3 sentences or bullets, lead with the verdict, no preamble, no wrap-up summary, no hedges or filler adjectives, no em dash, no semicolon in prose, never end with vague delegation. Recommend one default and state the exact next action.",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/hooks/stop-rules-gate.ps1",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\claude\\.claude\\hooks\\herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File ~/dev/windows-dev/claude/statusline.ps1"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "outputStyle": "Terse Engineer",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "bashOutputMaxChars": 10000,
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "switchModelsOnFlag": false
}
