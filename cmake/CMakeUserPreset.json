{
  "version": 4,
  "configurePresets": [
    {
      "name": "local-path",
      "hidden": true,
      "environment": {
        "PATH": "$env{LOCAL_MINGW};$env{LOCAL_CMAKE};$env{LOCAL_NINJA};C:/Program Files/Git/cmd;C:/Windows/System32;C:/Windows/System32/WindowsPowerShell/v1.0;C:/Windows;$env{PKG_CONFIG_PATH}"
      }
    },
    {
      "name": "msys2-tools",
      "hidden": true,
      "inherits": ["local-path"],
      "environment": {
        "LOCAL_MINGW": "C:/msys64/mingw64/bin",
        "LOCAL_CMAKE": "C:/Program Files/CMake/bin",
        "LOCAL_NINJA": "C:/msys64/mingw64/bin",
        "PKG_CONFIG_PATH": "C:/msys64/usr/bin"
      }
    },
    {
      "name": "vs-tools",
      "hidden": true,
      "inherits": ["local-path"],
      "environment": {
        "VS_BIN": "C:/Program Files/Microsoft Visual Studio/18/Community",
        "LOCAL_MINGW": "$env{VS_BIN}/VC/Tools/MSVC/14.50.35717/bin/Hostx64/x64",
        "LOCAL_CMAKE": "$env{VS_BIN}/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin",
        "LOCAL_NINJA": "$env{VS_BIN}/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja"
      }
    },
    {
      "name": "mingw-vcpkg-base",
      "hidden": true,
      "inherits": ["msys2-tools"],
      "environment": {
        "VCPKG_ROOT": "C:/vcpkg",
        "VCPKG_BINARY_SOURCES": "clear;files,C:/vcpkg/binary-cache,readwrite",
        "OPENSSL_ROOT_DIR": "C:/msys64/mingw64"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PKG_CONFIG_EXECUTABLE": "C:/msys64/mingw64/bin/pkg-config.exe",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TLSUV_TLSLIB": "openssl",
        "CMAKE_EXE_LINKER_FLAGS": "-static -static-libgcc -static-libstdc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-static-libgcc -static-libstdc++"
      }
    }
  ]
}
