{
  "version": 7,
  "include": [
    "$penv{USERPROFILE}/CMakeUserPreset.json"
  ],
  "configurePresets": [
    {
      "name": "cwdming",
      "inherits": ["mingw-vcpkg-base", "flags-windows-mingw"],
      "binaryDir": "${sourceDir}/build/cwdming",
      "environment": {
        "VCPKG_INSTALLED_DIR": "C:/vcpkg/installed-cwdming"
      }
    },
    {
      "name": "cwdming-win32crypto",
      "inherits": ["mingw-vcpkg-base", "flags-windows-mingw"],
      "binaryDir": "${sourceDir}/build/cwdming-win32crypto",
      "environment": {
        "VCPKG_INSTALLED_DIR": "C:/vcpkg/installed-cwdming-win32crypto"
      },
      "cacheVariables": {
        "TLSUV_TLSLIB": "win32crypto"
      }
    },
    {
      "name": "cwdming-localsdk",
      "inherits": ["mingw-vcpkg-base", "flags-windows-mingw"],
      "binaryDir": "${sourceDir}/build/cwdming-localsdk",
      "environment": {
        "VCPKG_INSTALLED_DIR": "C:/vcpkg/installed-cwdming"
      },
      "cacheVariables": {
        "ZITI_SDK_DIR": "$penv{USERPROFILE}/dev/openziti/ziti-sdk-c"
      }
    }
  ]
}
